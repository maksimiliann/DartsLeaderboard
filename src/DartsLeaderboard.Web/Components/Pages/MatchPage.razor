@page "/match/{MatchId:int}"
@using DartsLeaderboard.Application.Abstractions
@using DartsLeaderboard.Application.Matches
@using DartsLeaderboard.Web.Components.Match
@using DartsLeaderboard.Web.Speech
@implements IDisposable
@inject GetMatchStateService GetState
@inject RecordThrowService RecordThrow
@inject UndoLastThrowService UndoThrow
@inject AbandonMatchService AbandonMatch
@inject IMatchNotifier Notifier
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Матч #@MatchId</PageTitle>

@if (_state is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4" Spacing="2">
        <MudText Typo="Typo.h5">@_state.ModeTitle</MudText>
        <MudChip T="string" Size="Size.Small">Матч #@_state.MatchId</MudChip>
        <MudChip T="string" Size="Size.Small">Раунд @_state.CurrentRoundNumber</MudChip>
        @if (_state.IsInProgress)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Primary">Бросает: @_state.CurrentPlayerName</MudChip>
        }
        else
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Success">
                @_state.StatusTitle@(_state.WinnerPlayerName is null ? "" : $": {_state.WinnerPlayerName}")
            </MudChip>
        }
        <MudSpacer />
        @if (_state.IsInProgress)
        {
            <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="Abandon">Прервать матч</MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="@(() => Navigation.NavigateTo("/match/new"))">
                Новый матч
            </MudButton>
        }
    </MudStack>

    <MudGrid>
        <MudItem xs="12" md="7">
            <MudPaper Class="pa-2">
                <MatchScoreGrid State="_state" />
            </MudPaper>

            <MudGrid Class="mt-3" Spacing="3">
                @if (_state.Standings.Count > 0)
                {
                    <MudItem xs="12" sm="6">
                        <MatchStandings Standings="_state.Standings"
                                        ShowSpeakButton="@CanSpeakResults"
                                        Speaking="_speaking"
                                        SpeakLabel="@SpeakButtonText"
                                        SpeakIcon="@SpeakButtonIcon"
                                        OnSpeak="SpeakResults" />
                    </MudItem>
                }
                <MudItem xs="12" sm="@(_state.Standings.Count > 0 ? 6 : 12)">
                    <MatchStatsPanel Statistics="_state.MatchStatistics" />
                </MudItem>
            </MudGrid>

            @if (_state.ShowTrendChart)
            {
                <ThrowTrendChart Series="_state.ChartSeries" />
            }
        </MudItem>
        <MudItem xs="12" md="5">
            <MudPaper Class="pa-3">
                <DartboardInput Disabled="@(!_state.IsInProgress)" PlayerName="@_state.CurrentPlayerName"
                                Remaining="_state.CurrentRemaining" OnSubmit="Record" OnUndoThrow="Undo" />
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    private MatchStateDto? _state;
    private IDisposable? _subscription;
    private DotNetObjectReference<MatchPage>? _speechRef;
    private bool _speaking;
    private SpeechPlayback _playback = SpeechPlayback.Idle;

    private bool CanSpeakResults => _state is not null && ResultAnnouncement.CanSpeak(_state);

    private string SpeakButtonText => ResultAnnouncement.ButtonText(_playback);

    private string SpeakButtonIcon => _playback switch
    {
        SpeechPlayback.Playing => Icons.Material.Filled.Pause,
        SpeechPlayback.Paused => Icons.Material.Filled.PlayArrow,
        _ => Icons.Material.Filled.VolumeUp
    };

    [Parameter] public int MatchId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await Reload();
        _subscription = Notifier.Subscribe(MatchId, () => InvokeAsync(OnMatchChangedAsync));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _speechRef is not null)
        {
            return;
        }

        _speechRef = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("dartsSpeech.setEnded", _speechRef);
    }

    private async Task OnMatchChangedAsync()
    {
        if (_subscription is null)
        {
            return;
        }

        await Reload();
        StateHasChanged();
    }

    private async Task Reload()
    {
        var result = await GetState.ExecuteAsync(MatchId);
        if (!result.IsSuccess)
        {
            Snackbar.Add(result.ErrorMessage!, Severity.Error);
            Navigation.NavigateTo("/");
            return;
        }

        _state = result.Value;
    }

    private async Task Record(IReadOnlyList<ThrowDartDto> darts)
    {
        var result = await RecordThrow.ExecuteAsync(MatchId, darts);
        if (result.IsSuccess)
        {
            _state = result.Value;
            return;
        }

        Snackbar.Add(result.ErrorMessage!, Severity.Error);
        await Reload();
    }

    private async Task Undo()
    {
        var result = await UndoThrow.ExecuteAsync(MatchId);
        if (result.IsSuccess)
        {
            _state = result.Value;
            return;
        }

        Snackbar.Add(result.ErrorMessage!, Severity.Warning);
    }

    private async Task SpeakResults()
    {
        if (_state is null || _speaking)
        {
            return;
        }

        _speaking = true;
        try
        {
            var state = await JS.InvokeAsync<string>("dartsSpeech.toggle", ResultAnnouncement.Format(_state.Standings));
            _playback = state switch
            {
                "playing" => SpeechPlayback.Playing,
                "paused" => SpeechPlayback.Paused,
                _ => SpeechPlayback.Idle
            };
        }
        catch (Exception exception) when (exception is JSException or JSDisconnectedException)
        {
            _playback = SpeechPlayback.Idle;
            Snackbar.Add("Не удалось озвучить результат", Severity.Error);
        }
        finally
        {
            _speaking = false;
        }
    }

    [JSInvokable]
    public Task OnSpeechEnded()
    {
        _playback = SpeechPlayback.Idle;
        return InvokeAsync(StateHasChanged);
    }

    private async Task Abandon()
    {
        Unsubscribe();

        var result = await AbandonMatch.ExecuteAsync(MatchId);
        if (!result.IsSuccess)
        {
            _subscription = Notifier.Subscribe(MatchId, () => InvokeAsync(OnMatchChangedAsync));
            Snackbar.Add(result.ErrorMessage!, Severity.Error);
            return;
        }

        Navigation.NavigateTo("/");
    }

    public void Dispose()
    {
        _speechRef?.Dispose();
        try
        {
            _ = JS.InvokeVoidAsync("dartsSpeech.stop");
        }
        catch (JSDisconnectedException)
        {
        }

        Unsubscribe();
    }

    private void Unsubscribe()
    {
        _subscription?.Dispose();
        _subscription = null;
    }
}
