<MudPaper Class="pa-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
        <MudText Typo="Typo.overline">Сейчас</MudText>
        <MudSpacer />
        @if (ShowSpeakButton)
        {
            <MudButton Variant="Variant.Outlined"
                       Size="Size.Small"
                       StartIcon="@SpeakIcon"
                       Disabled="Speaking"
                       OnClick="OnSpeak"
                       data-testid="speak-results">
                @SpeakLabel
            </MudButton>
        }
    </MudStack>
    @foreach (var row in Standings)
    {
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="py-1" Spacing="2">
            <MudText Typo="Typo.subtitle2" Color="@(row.Place == 1 ? Color.Primary : Color.Default)"
                     Style="width: 1.5rem">@row.Place</MudText>
            <MudText Typo="Typo.body1">@row.PlayerName</MudText>
            <MudSpacer />
            <MudText Typo="Typo.subtitle1"><b>@row.Total</b></MudText>
        </MudStack>
    }
</MudPaper>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<StandingDto> Standings { get; set; } = Array.Empty<StandingDto>();

    [Parameter] public bool ShowSpeakButton { get; set; }

    [Parameter] public bool Speaking { get; set; }

    [Parameter] public string SpeakLabel { get; set; } = "Озвучить результат";

    [Parameter] public string SpeakIcon { get; set; } = Icons.Material.Filled.VolumeUp;

    [Parameter] public EventCallback OnSpeak { get; set; }
}
