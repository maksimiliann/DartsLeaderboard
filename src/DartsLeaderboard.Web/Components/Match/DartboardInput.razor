<div class="dartboard-input">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
        <MudText Typo="Typo.subtitle1">
            @(PlayerName is null ? "Очки" : $"Очки: {PlayerName}")
        </MudText>
        <MudChip T="string" Size="Size.Small">Сумма @_visit.Sum</MudChip>
        @for (var index = 0; index < 3; index++)
        {
            var slot = index;
            var dart = slot < _visit.Darts.Count ? _visit.Darts[slot] : (DartboardDart?)null;
            <MudChip T="string" Size="Size.Small" Color="@(dart is null ? Color.Default : Color.Primary)"
                     Variant="@(dart is null ? Variant.Outlined : Variant.Filled)">
                @(dart is null ? $"Дротик {slot + 1}" : $"{dart.Value.Label} · {dart.Value.Points}")
            </MudChip>
        }
    </MudStack>

    <MudStack Spacing="3">
        <svg class="dartboard @(Disabled ? "dartboard-disabled" : null)"
             viewBox="0 0 @((int)DartboardLayout.ViewBox) @((int)DartboardLayout.ViewBox)"
             role="img" aria-label="Мишень для ввода дротиков">
            @foreach (var slice in MissSlices)
            {
                <path class="@MissSliceClass(slice.Id, slice.SectorIndex)"
                      d="@slice.Path"
                      data-dart="@slice.Id"
                      @onclick="() => Hit(DartboardScoring.Miss, slice.Id)">
                    <title>Мимо</title>
                </path>
            }

            @foreach (var slice in Slices)
            {
                <path class="@SliceClass(slice.Id, slice.SectorIndex, slice.Ring)"
                      d="@slice.Path"
                      data-dart="@slice.Id"
                      @onclick="() => Hit(slice.Dart, slice.Id)">
                    <title>@slice.Dart.Label · @slice.Dart.Points</title>
                </path>
            }

            @foreach (var number in Numbers)
            {
                <SvgText Class="dartboard-number" X="@number.X" Y="@number.Y">@number.Sector</SvgText>
            }

            <circle class="@SliceClass("25", 1, DartboardRing.Double)"
                    cx="@F(DartboardLayout.Cx)" cy="@F(DartboardLayout.Cy)" r="@F(DartboardLayout.R25)"
                    data-dart="25"
                    @onclick="@(() => Hit(DartboardScoring.OuterBull, "25"))">
                <title>25</title>
            </circle>
            <circle class="@SliceClass("50", 0, DartboardRing.Double)"
                    cx="@F(DartboardLayout.Cx)" cy="@F(DartboardLayout.Cy)" r="@F(DartboardLayout.R50)"
                    data-dart="50"
                    @onclick="@(() => Hit(DartboardScoring.InnerBull, "50"))">
                <title>50</title>
            </circle>

            @foreach (var marker in HitMarkers)
            {
                <circle class="dartboard-hit" data-hit="@marker.Number"
                        cx="@marker.X" cy="@marker.Y" r="6.5"
                        fill="#e53935" stroke="#ffffff" stroke-width="1.25">
                    <title>Дротик @marker.Number</title>
                </circle>
                <SvgText Class="dartboard-hit-label" X="@marker.X" Y="@marker.Y" Fill="#ffffff">@marker.Number</SvgText>
            }
        </svg>

        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="dartboard-actions">
            <MudButton Variant="Variant.Text" Disabled="@(Disabled || _visit.Darts.Count == 0)" OnClick="UndoDart">
                Отменить дротик
            </MudButton>
            <MudSpacer />
            <MudButton Variant="Variant.Outlined" OnClick="OnUndoThrow">
                Отменить бросок
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       Disabled="@(Disabled || _visit.Darts.Count == 0)"
                       data-testid="submit-visit" OnClick="SubmitVisit">
                Записать бросок
            </MudButton>
        </MudStack>
    </MudStack>
</div>

@code {
    private static readonly (DartboardRing Ring, double Inner, double Outer, string IdPrefix)[] Rings =
    [
        (DartboardRing.Single, DartboardLayout.R25, DartboardLayout.RInnerSingle, "x1i"),
        (DartboardRing.Triple, DartboardLayout.RInnerSingle, DartboardLayout.RTriple, "x3"),
        (DartboardRing.Single, DartboardLayout.RTriple, DartboardLayout.ROuterSingle, "x1o"),
        (DartboardRing.Double, DartboardLayout.ROuterSingle, DartboardLayout.RDouble, "x2")
    ];

    private DartboardVisit _visit = new();
    private readonly List<string> _hitIds = [];
    private string? _lastHitId;
    private string? _trackedPlayer;

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public string? PlayerName { get; set; }

    [Parameter] public int? Remaining { get; set; }

    [Parameter] public EventCallback<IReadOnlyList<ThrowDartDto>> OnSubmit { get; set; }

    [Parameter] public EventCallback OnUndoThrow { get; set; }

    private IEnumerable<MissSlice> MissSlices
    {
        get
        {
            for (var index = 0; index < DartboardScoring.SectorOrder.Length; index++)
            {
                var sector = DartboardScoring.SectorOrder[index];
                var center = -90 + index * 18;
                yield return new MissSlice(
                    $"miss-{sector}",
                    index,
                    DartboardLayout.RingSlice(
                        DartboardLayout.RDouble,
                        DartboardLayout.RMiss,
                        center - 9,
                        center + 9));
            }
        }
    }

    private IEnumerable<Slice> Slices
    {
        get
        {
            for (var index = 0; index < DartboardScoring.SectorOrder.Length; index++)
            {
                var sector = DartboardScoring.SectorOrder[index];
                var center = -90 + index * 18;
                var start = center - 9;
                var end = center + 9;
                foreach (var ring in Rings)
                {
                    var dart = DartboardScoring.Sector(ring.Ring, sector);
                    var id = $"{ring.IdPrefix}-{sector}";
                    yield return new Slice(
                        id,
                        index,
                        ring.Ring,
                        DartboardLayout.RingSlice(ring.Inner, ring.Outer, start, end),
                        dart);
                }
            }
        }
    }

    private IEnumerable<NumberLabel> Numbers
    {
        get
        {
            for (var index = 0; index < DartboardScoring.SectorOrder.Length; index++)
            {
                var sector = DartboardScoring.SectorOrder[index];
                var (x, y) = DartboardLayout.Polar(DartboardLayout.RLabel, -90 + index * 18);
                yield return new NumberLabel(sector, F(x), F(y));
            }
        }
    }

    private IReadOnlyList<HitMarker> HitMarkers
    {
        get
        {
            var markers = new List<HitMarker>(_hitIds.Count);
            for (var index = 0; index < _hitIds.Count; index++)
            {
                var id = _hitIds[index];
                var sameTotal = _hitIds.Count(zone => zone == id);
                var sameIndex = _hitIds.Take(index + 1).Count(zone => zone == id) - 1;
                var (x, y) = DartboardLayout.HitMarker(id, sameIndex, sameTotal);
                markers.Add(new HitMarker(index + 1, F(x), F(y)));
            }

            return markers;
        }
    }

    protected override void OnParametersSet()
    {
        if (_trackedPlayer == PlayerName)
        {
            return;
        }

        _trackedPlayer = PlayerName;
        _visit = new DartboardVisit();
        _hitIds.Clear();
        _lastHitId = null;
    }

    private string SliceClass(string id, int sectorIndex, DartboardRing ring)
    {
        var parity = sectorIndex % 2 == 0 ? "even" : "odd";
        var tone = ring == DartboardRing.Single
            ? $"dartboard-slice-single-{parity}"
            : $"dartboard-slice-{parity}";
        var hit = id == _lastHitId ? " dartboard-slice-hit" : string.Empty;
        return $"dartboard-slice {tone}{hit}";
    }

    private string MissSliceClass(string id, int sectorIndex)
    {
        var parity = sectorIndex % 2 == 0 ? "even" : "odd";
        var hit = id == _lastHitId ? " dartboard-slice-hit" : string.Empty;
        return $"dartboard-slice dartboard-slice-miss-{parity}{hit}";
    }

    private async Task Hit(DartboardDart dart, string id)
    {
        if (Disabled || !_visit.TryAdd(dart))
        {
            return;
        }

        _lastHitId = id;
        _hitIds.Add(id);
        if (Remaining is int remaining)
        {
            var result = DartboardScoring.EvaluateX01Visit(remaining, _visit.Darts);
            if (result == X01VisitResult.Bust)
            {
                await FinishBust();
                return;
            }

            if (result == X01VisitResult.Checkout)
            {
                await FinishVisit();
                return;
            }
        }

        if (_visit.IsFull)
        {
            await SubmitVisit();
        }
    }

    private void UndoDart()
    {
        if (_visit.TryUndo())
        {
            if (_hitIds.Count > 0)
            {
                _hitIds.RemoveAt(_hitIds.Count - 1);
            }

            _lastHitId = _hitIds.LastOrDefault();
        }
    }

    private Task SubmitVisit()
    {
        if (_visit.Darts.Count == 0)
        {
            return Task.CompletedTask;
        }

        return FinishVisit();
    }

    private Task FinishBust()
    {
        _visit.Bust();
        return Finish([]);
    }

    private Task FinishVisit()
    {
        var darts = _visit.Darts
            .Select(dart => new ThrowDartDto(dart.Points, dart.IsDouble))
            .ToList();
        _visit.TakeSum();
        return Finish(darts);
    }

    private async Task Finish(IReadOnlyList<ThrowDartDto> darts)
    {
        _hitIds.Clear();
        _lastHitId = null;
        await OnSubmit.InvokeAsync(darts);
    }

    private static string F(double value) => value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private readonly record struct HitMarker(int Number, string X, string Y);

    private readonly record struct Slice(string Id, int SectorIndex, DartboardRing Ring, string Path, DartboardDart Dart);

    private readonly record struct MissSlice(string Id, int SectorIndex, string Path);

    private readonly record struct NumberLabel(int Sector, string X, string Y);
}
