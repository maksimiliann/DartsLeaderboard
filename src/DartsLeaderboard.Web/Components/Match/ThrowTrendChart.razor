<MudPaper Class="pa-4 mt-3">
    <MudText Typo="Typo.overline" Class="mb-2">Очки за раунд</MudText>

    @if (RoundCount == 0)
    {
        <MudText Typo="Typo.body2">Броски ещё не записаны.</MudText>
    }
    else
    {
        <MudChart T="double" ChartType="ChartType.Line" ChartSeries="ChartData" ChartLabels="Labels"
                  Height="260px" CanHideSeries="true" />
    }
</MudPaper>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<ChartSeriesDto> Series { get; set; } = Array.Empty<ChartSeriesDto>();

    private int RoundCount => Series.Count == 0 ? 0 : Series.Max(s => s.RoundPoints.Count);

    private string[] Labels => Enumerable.Range(1, RoundCount).Select(i => i.ToString()).ToArray();

    private List<ChartSeries<double>> ChartData => Series
        .Select(s => new ChartSeries<double>
        {
            Name = s.PlayerName,
            Data = s.RoundPoints.ToArray(),
            Visible = true
        })
        .ToList();
}
