<!DOCTYPE html>
<html lang="ru">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["DartsLeaderboard.Web.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script src="js/speech.js"></script>
    <script src="@Assets["_framework/blazor.web.js"]" autostart="false"></script>
    <script>
        window.dartsLayout = {
            isWide: function () {
                return window.matchMedia("(min-width: 960px)").matches;
            }
        };
        window.dartsTheme = {
            get: function () {
                var match = document.cookie.match(/(?:^|; )darts-theme=(dark|light)/);
                return match ? match[1] : null;
            },
            set: function (value) {
                document.cookie = 'darts-theme=' + value + '; path=/; max-age=31536000; SameSite=Lax';
            }
        };
        Blazor.start();
    </script>
</body>

</html>
