@inherits LayoutComponentBase
@implements IDisposable
@inject IJSRuntime JS
@inject NavigationManager Navigation

<MudThemeProvider @bind-IsDarkMode="_isDarkMode" ObserveSystemDarkModeChange="false" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       aria-label="@(_drawerOpen ? "Закрыть меню" : "Открыть меню")"
                       OnClick="@(() => _drawerOpen = !_drawerOpen)" />
        <MudText Typo="Typo.h6" Class="ml-2">Дартс</MudText>
        <MudSpacer />
        <MudTooltip Text="@(_isDarkMode ? "Светлая тема" : "Тёмная тема")">
            <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                           Color="Color.Inherit"
                           Edge="Edge.End"
                           aria-label="@(_isDarkMode ? "Включить светлую тему" : "Включить тёмную тему")"
                           data-testid="theme-toggle"
                           OnClick="ToggleTheme" />
        </MudTooltip>
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" Elevation="1" Variant="DrawerVariant.Responsive" Breakpoint="Breakpoint.Md">
        <NavMenu />
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-6 app-main">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen;
    private bool _isDarkMode;

    protected override void OnInitialized() => Navigation.LocationChanged += OnLocationChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var stored = await JS.InvokeAsync<string?>("dartsTheme.get");
        var wide = await JS.InvokeAsync<bool>("dartsLayout.isWide");
        var dark = stored == "dark";
        var changed = false;
        if (wide && !_drawerOpen)
        {
            _drawerOpen = true;
            changed = true;
        }

        if (dark != _isDarkMode)
        {
            _isDarkMode = dark;
            changed = true;
        }

        if (changed)
        {
            StateHasChanged();
        }
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        try
        {
            if (_drawerOpen && !await JS.InvokeAsync<bool>("dartsLayout.isWide"))
            {
                _drawerOpen = false;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (JSDisconnectedException)
        {
        }
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;

    private async Task ToggleTheme()
    {
        _isDarkMode = !_isDarkMode;
        await JS.InvokeVoidAsync("dartsTheme.set", _isDarkMode ? "dark" : "light");
    }
}
